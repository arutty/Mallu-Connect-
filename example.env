# ---------------------------------------------------------------------------
# Web2APK - signing keys (ALL OPTIONAL)
#
# Do NOT commit real values. In GitHub add them as repository secrets:
#   Settings -> Secrets and variables -> Actions -> New repository secret
# (use the same names as below). For a local build copy this file to `.env`.
#
# If KEYSTORE_BASE64 is empty, a temporary keystore is generated automatically
# on every build. That APK installs fine, but it cannot be installed as an
# UPDATE over an APK built with a different key. For stable updates create
# one keystore once and store it in the secrets below.
#
# Create a keystore once:
#   keytool -genkeypair -v -keystore my.keystore -alias myalias \
#     -keyalg RSA -keysize 2048 -validity 10000
# Turn it into one line for KEYSTORE_BASE64:
#   base64 -w0 my.keystore
# ---------------------------------------------------------------------------

# base64 text of your keystore file
KEYSTORE_BASE64=

# keystore password
KEYSTORE_PASSWORD=

# key alias used when the keystore was created (e.g. myalias)
KEY_ALIAS=

# key password (optional - defaults to KEYSTORE_PASSWORD)
KEY_PASSWORD=
